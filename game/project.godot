; Engine configuration file.
; Prefer editing through reviewed source changes or a compatible Godot 4 editor.

config_version=5

[application]

config/name="Forge2D Template"
config/version="0.1.0"
run/main_scene="res://scenes/bootstrap.tscn"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.047, 0.059, 0.078, 1)
